    "username": "#username",
    "password": "#password",
    "submit": "button[type=submit]",
    "success": ".user-name",
    "captcha": ""
  },
  "preSteps": [
    {
      "type": "click",
      "text": "出库管理"
    },
    {
      "type": "click",
      "text": "出库流程节点时间跟踪"
    }
  ],
  "query": {
    "dateInput": "input[name=orderDate]",
    "dateEndInput": "",
    "search": {
      "text": "查询"
    },
    "result": ".el-table__row",
    "empty": ".el-table__empty-text",
    "download": {
      "text": "导出"
    },
    "downloadFetchUrl": "",
    "downloadWaitMs": 120000
  },
  "validation": {
    "extensions": [
      ".xlsx",
      ".xls",
      ".csv"
