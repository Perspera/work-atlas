{
  "url": "https://wms.example.com/",
  "queryUrl": "",
  "dateMode": "yesterday",
  "dateFormat": "YYYY-MM-DD",
  "timezone": "Asia/Shanghai",
  "headless": true,
  "downloadDir": "downloads/tmp",
  "deliverDir": "Z:\\单据登记\\测试",
  "overwriteDeliver": true,
  "keepDownloadCopy": true,
  "timeoutMs": 60000,
